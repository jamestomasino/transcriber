# ============================================================================
# Transcriber — distribution secrets (LOCAL ONLY)
# ----------------------------------------------------------------------------
# Copy this file to `.env`, fill it in, and `source` it before `bash build.sh`.
# `.env` is git-ignored. NEVER commit it.
#
# IMPORTANT — two kinds of secrets (see docs/DISTRIBUTION.md §0):
#   * RUNTIME secrets (OpenAI/Anthropic keys) do NOT go here. Those live in
#     the macOS Keychain on each user's Mac, entered via the app's Settings.
#     The app bundles no secrets.
#   * DISTRIBUTION secrets (below) are only for YOU, at build/sign/notarize
#     time. In CI these same values become GitHub Secrets (see §5 of the doc).
# ============================================================================

# --- Signing identity --------------------------------------------------------
# Run:  security find-identity -v -p codesigning
# and copy the exact string between the quotes. Looks like:
TRANSCRIBER_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID123)"

# Optional: a .p12 export of that cert (base64) + its password. Useful when
# importing into a fresh keychain (e.g. a CI runner). Leave empty locally if
# the cert is already in your login keychain.
# TRANSCRIBER_P12_BASE64=""
# TRANSCRIBER_P12_PASSWORD=""

# --- Notarization ------------------------------------------------------------
# 1 = notarize after signing (required for distribution to other Macs).
# 0/empty = skip (ad-hoc build, runs only on the machine that built it).
TRANSCRIBER_NOTARIZE=1

# Pick ONE notarization method:
#
# Method 1 (recommended): App Store Connect API key
#   - Key file:  export the .p8 from App Store Connect → Users and Access →
#                Keys → App Store Connect API → generate → download.
#   - KEY_ID and ISSUER are shown on the same page as the key.
TRANSCRIBER_ASC_KEY_PATH="$HOME/keys/AuthKey_ABC123.p8"
TRANSCRIBER_ASC_KEY_ID="ABC123XYZ"
TRANSCRIBER_ASC_ISSUER="12345678-1234-1234-1234-123456789abc"

# Method 2 (fallback): Apple ID + app-specific password
#   - App-specific password: appleid.apple.com → Sign-In and Security →
#     App-Specific Passwords.
# TRANSCRIBER_TEAM_ID="YOURTEAMID"
# TRANSCRIBER_APPLE_ID="you@example.com"
# TRANSCRIBER_APPLE_PW="abcd-efgh-ijkl-mnop"

# Optional bundle identifier for your distribution build:
# TRANSCRIBER_BUNDLE_ID="com.yourname.transcriber"
